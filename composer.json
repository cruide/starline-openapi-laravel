{
    "name": "kengois/starline-api",
    "description": "Laravel client for the StarLine OpenAPI (SLID auth, device state & remote control)",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "starline", "api", "slid", "telematics"],
    "authors": [
        {
            "name": "Alexander Tischenko",
            "homepage": "http://alex-tisch.ru"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../starline-openapi-php"
        }
    ],
    "require": {
        "php": "^8.2",
        "cruide/starline-openapi-php": "@dev",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/cache": "^12.0",
        "illuminate/support": "^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "StarlineApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StarlineApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StarlineApi\\StarlineServiceProvider"
            ],
            "aliases": {
                "Starline": "StarlineApi\\Facades\\Starline"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
